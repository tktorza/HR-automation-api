// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TABLE: tenants (multi-tenant support)
// ============================================
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  users            User[]
  linkedinAccounts LinkedinAccount[]
  contacts         Contact[]
  conversations    Conversation[]
  llmActions       LlmAction[]
  notifications    Notification[]
  llmQuotas        LlmQuota[]
  onboardingConfig OnboardingConfig?

  @@index([slug])
  @@map("tenants")
}

// ============================================
// TABLE: users (utilisateurs de l'app)
// ============================================
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("admin") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  resetToken   String?   @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ============================================
// TABLE: linkedin_accounts (credentials chiffrés)
// ============================================
model LinkedinAccount {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  emailEncrypted         String    @map("email_encrypted")
  passwordEncrypted      String    @map("password_encrypted")
  sessionCookies         String?   @map("session_cookies")
  lastScrapeAt           DateTime? @map("last_scrape_at") @db.Timestamptz
  sessionExpiresAt       DateTime? @map("session_expires_at") @db.Timestamptz
  isActive               Boolean   @default(true) @map("is_active")
  scrapeFrequencyMinutes Int       @default(10) @map("scrape_frequency_minutes")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("linkedin_accounts")
}

// ============================================
// TABLE: contacts (candidats/clients)
// ============================================
model Contact {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  linkedinProfileUrl String   @unique @map("linkedin_profile_url")
  email              String?  @db.VarChar(255)
  firstName          String?  @map("first_name") @db.VarChar(100)
  lastName           String?  @map("last_name") @db.VarChar(100)
  fullName           String?  @map("full_name") @db.VarChar(255)
  type               String?  @default("candidate") @db.VarChar(50)
  source             String?  @default("linkedin_standard") @db.VarChar(50)
  status             String?  @default("new") @db.VarChar(50)
  jobTitle           String?  @map("job_title") @db.VarChar(255)
  company            String?  @db.VarChar(255)
  metadata           Json?    @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([linkedinProfileUrl])
  @@map("contacts")
}

// ============================================
// TABLE: conversations (historique messages)
// ============================================
model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId     String    @map("contact_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  messages      Json?     @default("[]")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  lastScrapedAt DateTime? @map("last_scraped_at") @db.Timestamptz
  unreadCount   Int       @default(0) @map("unread_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  llmActions LlmAction[]

  @@index([contactId])
  @@index([tenantId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// ============================================
// TABLE: llm_actions (logs des actions LLM)
// ============================================
model LlmAction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  actionType      String   @map("action_type") @db.VarChar(50)
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(5, 2)
  prompt          String?
  llmResponse     Json?    @map("llm_response")
  finalMessage    String?  @map("final_message")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
  @@index([tenantId, actionType])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("llm_actions")
}

// ============================================
// TABLE: notifications (emails/alerts)
// ============================================
model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  type           String    @db.VarChar(50)
  recipientEmail String    @map("recipient_email") @db.VarChar(255)
  subject        String?   @db.VarChar(500)
  message        String?
  metadata       Json?     @default("{}")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, sentAt(sort: Desc)])
  @@map("notifications")
}

// ============================================
// TABLE: llm_quotas (gestion budgets Claude)
// ============================================
model LlmQuota {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  monthYear        String   @map("month_year") @db.VarChar(7)
  tokensConsumed   BigInt   @default(0) @map("tokens_consumed")
  estimatedCostUsd Decimal  @default(0.00) @map("estimated_cost_usd") @db.Decimal(10, 2)
  monthlyLimitUsd  Decimal  @default(50.00) @map("monthly_limit_usd") @db.Decimal(10, 2)
  isLimitReached   Boolean  @default(false) @map("is_limit_reached")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, monthYear])
  @@index([tenantId])
  @@map("llm_quotas")
}

// ============================================
// TABLE: onboarding_configs (questionnaire)
// ============================================
model OnboardingConfig {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  detectedStyle       Json?    @map("detected_style")
  userAdjustments     Json?    @map("user_adjustments")
  businessInfo        Json?    @map("business_info")
  responseRules       Json?    @map("response_rules")
  calendarLink        String?  @map("calendar_link")
  confidenceThreshold Int      @default(70) @map("confidence_threshold")
  notificationEmails  String[] @map("notification_emails")
  
  // Hybrid LLM Config
  googleAiApiKey        String?  @map("google_ai_api_key")
  llmProviderPreference String?  @default("auto") @map("llm_provider_preference") // auto, gemini-only, claude-only

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("onboarding_configs")
}
